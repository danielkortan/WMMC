{
  "name": "wmmc",
  "version": "1.0.0",
  "description": "Whit Merrifield Memorial Cup Fantasy Baseball App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint server.js app.js js/ scripts/",
    "lint:fix": "eslint server.js app.js js/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sanitize:db": "node scripts/sanitize-db.js",
    "refresh:fixture": "bash scripts/refresh-fixture.sh",
    "test": "node --test tests/*.test.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.1"
  }
}
